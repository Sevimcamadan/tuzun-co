<style>
  #tz-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  #tz-popup-overlay.is-visible {
    opacity: 1;
    pointer-events: all;
  }

  #tz-popup {
    position: relative;
    display: flex;
    width: min(860px, 94vw);
    max-height: 92vh;
    background: #fff;
    overflow: hidden;
  }

  /* ── Left image column ── */
  #tz-popup-image {
    flex: 0 0 42%;
    background: #e8e4df;
    overflow: hidden;
  }

  #tz-popup-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ── Right form column ── */
  #tz-popup-body {
    flex: 1 1 auto;
    padding: 44px 40px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
  }

  #tz-popup-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    color: #111;
    padding: 4px;
    z-index: 1;
  }

  #tz-popup-close:hover { opacity: 0.45; }

  #tz-popup-logo {
    display: block;
    width: 68px;
    margin: 0 auto 22px;
  }

  #tz-popup-content h2 {
    font-family: 'Acumin Pro Wide', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.15;
    color: #111;
    margin: 0 0 10px;
    text-align: center;
  }

  #tz-popup-content p {
    font-family: 'Aileron', sans-serif;
    font-size: 0.85rem;
    line-height: 1.55;
    color: #666;
    margin: 0 0 24px;
    letter-spacing: 0.02em;
    text-align: center;
  }

  /* Two-column row for first/last name */
  .tz-popup-row {
    display: flex;
    gap: 10px;
    margin-bottom: 0;
  }

  .tz-popup-row-field {
    flex: 1 1 0;
    min-width: 0;
  }

  .tz-popup-row-field .tz-popup-field {
    width: 100%;
  }

  .tz-popup-field {
    display: block;
    width: 100%;
    border: 1.5px solid #ccc;
    outline: none;
    padding: 11px 13px;
    font-family: 'Aileron', sans-serif;
    font-size: 0.85rem;
    color: #111;
    background: transparent;
    margin-bottom: 10px;
    border-radius: 0;
    text-align: left;
    box-sizing: border-box;
  }

  .tz-popup-field:focus { border-color: #111; }
  .tz-popup-field::placeholder { color: #aaa; }

  .tz-popup-field.is-invalid {
    border-color: #dc2626;
  }

  .tz-field-error {
    display: none;
    font-family: 'Aileron', sans-serif;
    font-size: 0.75rem;
    color: #dc2626;
    margin-top: -6px;
    margin-bottom: 8px;
    letter-spacing: 0.01em;
  }

  .tz-field-error.is-visible {
    display: block;
  }

  #tz-submit-error {
    display: none;
    font-family: 'Aileron', sans-serif;
    font-size: 0.8rem;
    color: #dc2626;
    text-align: center;
    margin-top: 8px;
    letter-spacing: 0.01em;
  }

  #tz-submit-error.is-visible {
    display: block;
  }

  textarea.tz-popup-field {
    resize: none;
    height: 88px;
    line-height: 1.5;
  }

  .tz-popup-btn {
    display: block;
    width: 100%;
    padding: 14px;
    background: #111;
    color: #fff;
    border: none;
    cursor: pointer;
    font-family: 'Aileron', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.2s;
    margin-top: 6px;
  }

  .tz-popup-btn:hover { background: #333; }

  #tz-popup-success {
    display: none;
    text-align: center;
    padding: 20px 0 10px;
  }

  #tz-popup-success p {
    font-family: 'Aileron', sans-serif;
    font-size: 0.9rem;
    color: #111;
    margin: 0;
    letter-spacing: 0.03em;
  }

  /* Mobile: hide image column */
  @media (max-width: 599px) {
    #tz-popup-image {
      display: none;
    }
    #tz-popup-body {
      padding: 40px 22px 32px;
    }
    .tz-popup-row {
      flex-direction: column;
      gap: 0;
    }
    .tz-popup-row-field {
      width: 100%;
    }
  }
</style>

<div id="tz-popup-overlay" aria-modal="true" role="dialog">
  <div id="tz-popup">

    <button id="tz-popup-close" aria-label="Close">&#x2715;</button>

    {%- if section.settings.image != blank -%}
      <div id="tz-popup-image">
        {{
          section.settings.image
          | image_url: width: 800
          | image_tag:
            loading: 'eager',
            alt: section.settings.image.alt | default: 'TÜZÜN',
            widths: '400, 600, 800'
        }}
      </div>
    {%- endif -%}

    <div id="tz-popup-body">
      <img
        id="tz-popup-logo"
        src="{{ 'Tuzun-Logo.png' | asset_url }}"
        alt="TÜZÜN"
        width="68"
        height="auto">

      <div id="tz-popup-content">
        <h2>{{ section.settings.heading | default: "Let's Work Together" }}</h2>
        <p>{{ section.settings.subtext | default: "Tell us about your project. We'll be in touch within 48 hours." }}</p>

        <div class="tz-popup-row">
          <div class="tz-popup-row-field">
            <input class="tz-popup-field" type="text" id="tz-first-name" placeholder="First name" autocomplete="given-name">
            <span class="tz-field-error" id="tz-first-name-error">First name is required.</span>
          </div>
          <div class="tz-popup-row-field">
            <input class="tz-popup-field" type="text" id="tz-last-name" placeholder="Last name" autocomplete="family-name">
          </div>
        </div>

        <input class="tz-popup-field" type="text" id="tz-brand" placeholder="Brand / Agency" autocomplete="organization">
        <input class="tz-popup-field" type="email" id="tz-email" placeholder="Email address" autocomplete="email">
        <span class="tz-field-error" id="tz-email-error">A valid email address is required.</span>

        <textarea class="tz-popup-field" id="tz-message" placeholder="What would you like to discuss?"></textarea>
        <span class="tz-field-error" id="tz-message-error">Please tell us what you'd like to discuss.</span>

        <button class="tz-popup-btn" id="tz-popup-submit">
          {{ section.settings.button_label | default: 'Start the Conversation' }}
        </button>
        <span id="tz-submit-error">Something went wrong. Please try again.</span>
      </div>

      <div id="tz-popup-success">
        <p>Thank you — we'll be in touch shortly.</p>
      </div>
    </div>

  </div>
</div>

<script>
  (function () {
    var overlay   = document.getElementById('tz-popup-overlay');
    var popup     = document.getElementById('tz-popup');
    var closeBtn  = document.getElementById('tz-popup-close');
    var submitBtn = document.getElementById('tz-popup-submit');
    var form      = document.getElementById('tz-popup-content');
    var success   = document.getElementById('tz-popup-success');

    function openPopup() {
      overlay.classList.add('is-visible');
    }

    function closePopup() {
      overlay.classList.remove('is-visible');
    }

    overlay.addEventListener('click', function (e) {
      if (!popup.contains(e.target)) closePopup();
    });

    closeBtn.addEventListener('click', closePopup);

    function setError(fieldId, errorId, condition) {
      var field = document.getElementById(fieldId);
      var error = document.getElementById(errorId);
      if (condition) {
        field.classList.add('is-invalid');
        error.classList.add('is-visible');
        return true;
      } else {
        field.classList.remove('is-invalid');
        error.classList.remove('is-visible');
        return false;
      }
    }

    function clearErrors() {
      ['tz-first-name', 'tz-email', 'tz-message'].forEach(function (id) {
        document.getElementById(id).classList.remove('is-invalid');
      });
      ['tz-first-name-error', 'tz-email-error', 'tz-message-error'].forEach(function (id) {
        document.getElementById(id).classList.remove('is-visible');
      });
      document.getElementById('tz-submit-error').classList.remove('is-visible');
    }

    ['tz-first-name', 'tz-email', 'tz-message'].forEach(function (id) {
      document.getElementById(id).addEventListener('input', function () {
        this.classList.remove('is-invalid');
        var errorEl = document.getElementById(id + '-error');
        if (errorEl) errorEl.classList.remove('is-visible');
      });
    });

    submitBtn.addEventListener('click', function () {
      var firstEl   = document.getElementById('tz-first-name');
      var emailEl   = document.getElementById('tz-email');
      var messageEl = document.getElementById('tz-message');

      var first   = firstEl.value.trim();
      var email   = emailEl.value.trim();
      var message = messageEl.value.trim();
      var emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

      var hasError = false;
      hasError = setError('tz-first-name', 'tz-first-name-error', !first)   || hasError;
      hasError = setError('tz-email',      'tz-email-error',      !emailValid) || hasError;
      hasError = setError('tz-message',    'tz-message-error',    !message)  || hasError;

      if (hasError) return;

      var SHEET_URL = 'https://script.google.com/macros/s/AKfycbw-o6v9NGo8L-9Q2c_w0tYMx7QhDtOeB6H9zNVsf6kiQ2AmooNIvKs_SpjBIaph-k7NAA/exec';
      var originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      fetch(SHEET_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: first,
          lastName:  document.getElementById('tz-last-name').value.trim(),
          brand:     document.getElementById('tz-brand').value.trim(),
          email:     email,
          message:   message
        })
      })
      .then(function () {
        form.style.display    = 'none';
        success.style.display = 'block';
        setTimeout(closePopup, 3000);
      })
      .catch(function () {
        submitBtn.disabled    = false;
        submitBtn.textContent = originalLabel;
        document.getElementById('tz-submit-error').classList.add('is-visible');
      });
    });

    setTimeout(openPopup, 400);
  })();
</script>

{% schema %}
{
  "name": "Contact Popup",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Popup image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's Work Together"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Tell us about your project. We'll be in touch within 48 hours."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start the Conversation"
    }
  ],
  "presets": [
    { "name": "Contact Popup" }
  ]
}
{% endschema %}
